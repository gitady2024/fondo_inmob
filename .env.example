# Configuración de Supabase
# Obtén estas credenciales en: https://app.supabase.com -> Tu Proyecto -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Configuración de Google Gemini AI (Gratuito en https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

